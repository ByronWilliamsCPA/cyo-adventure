# Git worktrees
.worktrees/

# Compliance report outputs
docs/compliance-reports/

# Superpowers generated plan files
docs/superpowers/plans/

# Superpowers visual brainstorming companion (mockup scratch files)
.superpowers/

# Naive-user QA reports: pasted-back browser responses may contain real
# children's/guardians' names, emails, or account details. Keep them local;
# the tracked .gitkeep preserves the directory.
docs/qa/naive-ux-reports/*.md

# Agent-session worktrees (auto-created by subagent isolation)
.claude/worktrees/

# Diversity eval live-fill and judge-calibration outputs (run_diversity_eval.py
# --with-judge writes its cache here); never committed by accident.
out/diversity/

# WS-5 mutation promotion bundles (scripts/mutate_skeleton.py --out-dir
# out/mutations/). Scratch: a mutant reaches the catalog only through a reviewed
# skeletons/ PR (ADR-020, design CR-1), never by committing a raw bundle.
out/mutations/

# Template feedback is deliberately local-only. It is a running note to the
# cookiecutter-python-template maintainers, not a project deliverable, and
# tracking it made every session's observations part of this repo's history and
# its published docs site. Keep writing to docs/template_feedback.md; it simply
# stays on the machine that wrote it. Excluded from the docs build in
# mkdocs.yml's exclude_docs, and still on cruft's skip list in pyproject.toml so
# an update never overwrites it. Format reference: .standards/template_feedback.baseline.md
docs/template_feedback.md

# lychee's link-check cache, written to the repo root by `--cache` in the
# link-check job and by any local `lychee --cache` run. It is per-machine
# state keyed by URL, restored in CI from the actions/cache entry rather than
# from git.
.lycheecache

# A paid harness writes its pid here while it runs (w7_battery.py::single_run),
# so a second instance refuses to start against the same output directory. It is
# live process state, never a result, and a committed one would name a pid that
# does not exist on the next machine.
**/.run.lock

# W7 known-bad battery arms. Every one of them is regenerated for free from
# out/w7/corpus/ plus out/w7/harden/: the mechanical arms by seed_defects.py,
# and the reading_level_up arm by `w7_battery.py --reblend`, which composes it
# from the rewrites rather than calling a provider. out/w7/harden/ is the paid
# half and stays tracked, so re-targeting the seed's magnitude never costs
# money again.
out/w7/arms/

# Production moderation-report snapshots taken before a re-moderation sweep.
# Real child-facing story content and verdicts; never commit.
.remoderation-backups/
