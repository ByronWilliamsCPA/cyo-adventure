{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "wff-plugins": {
      "source": {
        "source": "github",
        "repo": "ByronWilliamsCPA/plugin"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "wff-code@wff-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run basedpyright:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run bandit:*)",
      "Bash(uv run pip-audit:*)",
      "Bash(pre-commit:*)",
      "Bash(git:*)",
      "Bash(gh:*)"
    ]
  }
}
