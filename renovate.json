{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "after 10pm every weekday",
    "before 5am every weekday",
    "every weekend"
  ],
  "labels": [
    "dependencies",
    "automated"
  ],
  "assignees": [
    "williaby"
  ],
  "reviewers": [
    "williaby"
  ],
  "packageRules": [
    {
      "description": "Group Python dependencies by type",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependencies"],
      "groupName": "Python dependencies",
      "automerge": false,
      "schedule": ["every weekend"]
    },
    {
      "description": "Group Python dev/optional dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["optional-dependencies"],
      "groupName": "Python dev dependencies",
      "automerge": false,
      "schedule": ["every weekend"]
    },
    {
      "description": "Group container base image digest bumps",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Container base images",
      "labels": ["dependencies", "docker"],
      "automerge": false
    },
    {
      "description": "Keep pre-commit hook versions in step with the lockfile",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "automerge": false
    },
    {
      "description": "Auto-merge GitHub Actions minor/patch/digest updates. Digest is included deliberately (issue #552): the grouped Actions PR also carries digest-only members (a SHA re-pin of an unchanged tag, or a workflow `services: image:` digest bump), and Renovate disables auto-merge for the whole group when any member is not automergeable, so without digest here no grouped Actions PR could ever auto-merge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "description": "Security updates - high priority. Datasource ids, not manager ids: GitHub Actions resolve via github-tags / github-releases, and the former `github-actions` entry here was a manager id that matched nothing (issue #552)",
      "matchDatasources": ["pypi", "github-tags", "github-releases"],
      "labels": ["security", "dependencies"],
      "automerge": false,
      "schedule": ["at any time"]
    },
    {
      "description": "Pin GitHub Actions to commit SHA",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Never SHA-pin the SLSA generator (the #378 breakage). Its reusable workflow resolves its own builder from the calling ref and rejects anything that is not refs/tags/vX.Y.Z, so a digest pin fails with 'Invalid ref' while the generator job still reports success and only the final gate turns red on exit 27. This rule must stay after the pinDigests rule above to override it; see the DO-NOT-SHA-PIN comment in .github/workflows/slsa-provenance.yml.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "slsa-framework/slsa-github-generator",
        "slsa-framework/slsa-github-generator/**"
      ],
      "pinDigests": false,
      "automerge": false,
      "labels": ["dependencies", "manual-review"]
    },
    {
      "description": "Pydantic v2 - maintain major version",
      "matchPackageNames": ["pydantic", "pydantic-settings"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "labels": ["dependencies", "breaking-change"]
    },
    {
      "description": "Python version updates - manual review required",
      "matchDepTypes": ["python"],
      "enabled": false,
      "labels": ["dependencies", "python-version", "breaking-change"]
    },
    {
      "description": "Builder and runtime stage Python images move in lockstep, by hand: Renovate may only propose digest updates for them, never version bumps, so the two Dockerfile FROM lines cannot drift apart (issue #295; the #288 breakage)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python", "ghcr.io/byronwilliamscpa/dhi-python"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false,
      "labels": ["dependencies", "python-version", "breaking-change"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"],
    "commitMessageAction": "Update",
    "automerge": false,
    "labels": ["dependencies", "lock-file-maintenance"]
  },
  "minimumReleaseAge": "3 days",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "assignees": ["williaby"],
    "reviewers": ["williaby"]
  },
  "osvVulnerabilityAlerts": true,
  "transitiveRemediation": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+.*?_VERSION:\\s*[\"']?(?<currentValue>.*?)[\"']?\\s"
      ]
    },
    {
      "description": "Bump digest-pinned container images embedded in workflow run steps (e.g. the nginx.conf syntax check in ci.yml)",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "npm",
    "dockerfile",
    "docker-compose",
    "pre-commit"
  ]
}
