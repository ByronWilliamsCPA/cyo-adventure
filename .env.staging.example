# =============================================================================
# CYO Adventure - STAGING environment (Supabase staging project)
# =============================================================================
# Copy to `.env.staging` and fill from the Supabase dashboard (staging
# project): Settings > Database (connection string, session mode) and
# Settings > API (Project URL, publishable key, secret key). Supabase's
# current dashboard issues the new `sb_publishable_...` / `sb_secret_...` key
# formats shown below (legacy `anon` / `service_role` JWTs still work if your
# project predates the rotation, but prefer the new keys for new projects).
# Usage: uv run --env-file .env.staging <command>
# NEVER commit .env.staging (already git-ignored). No real secrets in this
# template; every value below is a placeholder.

ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Moderation review provider escape hatch (Stage A, moderation review
# redesign, design doc section 2.4 / gap G1)
# -----------------------------------------------------------------------------
# review_provider defaults to "mock" (no REVIEW_PROVIDER var below), and
# core/config.py now refuses to boot with the mock reviewer outside
# environment="local" unless CYO_ADVENTURE_ALLOW_MOCK_REVIEW=1 is set.
#
# The hatch is DELIBERATELY LEFT COMMENTED OUT below. This file is the general
# staging environment for ANY command (see the Usage line above), not only the
# seed scripts: `uv run --env-file .env.staging uvicorn ...`, the RQ worker,
# and the local-dev-against-staging setup in
# .claude/skills/naive-ux-check/SKILL.md all read it. Setting the hatch here
# would boot a SERVING process with mock moderation against the staging
# database, which is exactly the condition that produced the original flood of
# structural fail-safe flags.
#
# Set it per-command instead, on the one invocation that needs it, matching how
# each seed script documents it in its own module docstring:
#
#   CYO_ADVENTURE_ALLOW_MOCK_REVIEW=1 \
#       uv run --env-file .env.staging python scripts/seed_staging.py
#
# (uv leaves an already-set environment variable alone, and this file no longer
# defines one, so there is nothing to conflict with.)
#
# That is a deliberate non-evidence exception, not a real safety-review bypass:
# the seed scripts never call the real moderation pipeline, they write
# hand-authored or already-validated fixture blobs directly. Every report the
# mock reviewer does touch is stamped reviewer_independent=false plus a
# structural advisory finding regardless.
# CYO_ADVENTURE_ALLOW_MOCK_REVIEW=1

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Supabase Supavisor pooler)
# -----------------------------------------------------------------------------
# Session-mode pooler (port 5432), the default below, works with asyncpg's
# prepared-statement cache as-is. The transaction-mode pooler (port 6543) is
# faster under load but reassigns backend connections mid-session, so it
# requires CYO_ADVENTURE_DATABASE_DISABLE_PREPARED_CACHE=true or the app
# refuses to start (see core/config.py's pooler-port validator).
#
# ADR-021 cutover: post-cutover this is the cyo_api DSN, NOT the postgres
# owner. RLS never applies to a table's owner, so every RLS policy in this
# schema, including ADR-022's Tier 1 per-family predicates, is inert while
# this names `postgres`. Verify which role is actually live via
# /health/ready's `database_privilege` check rather than by reading this file.
CYO_ADVENTURE_DATABASE_URL=postgresql+asyncpg://postgres.<staging-ref>:<db-password>@<pooler-host>:5432/postgres
# CYO_ADVENTURE_DATABASE_DISABLE_PREPARED_CACHE=true
#
# The worker processes' own least-privilege credential (the cyo_worker role).
# UNSET IS NOT NEUTRAL: core/config.py falls back to CYO_ADVENTURE_DATABASE_URL,
# so a forgotten value silently leaves the worker on the API's credential and
# looks identical to a completed cutover. Set it explicitly as part of
# docs/operations/runbook.md section 11.
# CYO_ADVENTURE_WORKER_DATABASE_URL=postgresql+asyncpg://cyo_worker:<worker-password>@<pooler-host>:5432/postgres

# -----------------------------------------------------------------------------
# Authentication - OIDC / Supabase Auth (ADR-009)
# -----------------------------------------------------------------------------
# Backend JWT verification against the staging project's GoTrue issuer. Both
# REQUIRED outside "local" (see core/config.py's OIDC validator).
OIDC_ISSUER=https://<staging-ref>.supabase.co/auth/v1
OIDC_JWKS_URL=https://<staging-ref>.supabase.co/auth/v1/.well-known/jwks.json
OIDC_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# Child sessions - kid-surface tokens (G1 / P6-04)
# -----------------------------------------------------------------------------
# Signs the guardian-minted, child-scoped HS256 session tokens. REQUIRED outside
# "local" (see core/config.py's child-session validator). Generate a fresh
# high-entropy value (>=32 bytes), distinct from any other environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHILD_SESSION_SECRET=REPLACE_ME
# Optional; defaults to 43200 (12h) if unset.
# CHILD_SESSION_TTL_SECONDS=43200

# -----------------------------------------------------------------------------
# Device grants - durable device authorization (ADR-014 phase 1)
# -----------------------------------------------------------------------------
# Signs the guardian-minted, family-scoped, durable HS256 device grant tokens.
# REQUIRED outside "local" (see core/config.py's device-grant validator).
# MUST be a different value than CHILD_SESSION_SECRET. Generate a fresh
# high-entropy value (>=32 bytes), distinct from any other environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_GRANT_SECRET=REPLACE_ME
# Optional; defaults to 7776000 (90 days) if unset.
# DEVICE_GRANT_TTL_SECONDS=7776000

# -----------------------------------------------------------------------------
# Supabase admin API (staging seed script only; secret key is SECRET)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<staging-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME

# -----------------------------------------------------------------------------
# Frontend (copy into frontend/.env.local when pointing the UI at staging)
# -----------------------------------------------------------------------------
# Deliberate deviation from .env.example's split convention: local dev keeps
# separate backend (.env.example) and frontend (frontend/.env.example)
# templates, but staging is a single combined template covering both, since
# one Supabase project backs both surfaces for this environment.
VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# -----------------------------------------------------------------------------
# Story generation - real provider path, bounded cost.
#
# CHANGED with the Ollama retirement. Staging used to run the free local Ollama
# leg so test runs placed no billed LLM calls at all. That leg is gone, so
# staging now exercises the real OpenRouter adapter (the same code path
# production takes) against a deliberately CHEAP pinned model rather than the
# production Haiku/Sonnet pair.
#
# #CRITICAL: payment/financial: staging generation runs are now BILLED, where
# they previously were not. deepseek-v4-flash is ~$0.14/$0.28 per Mtok
# (core/pricing.py) versus Haiku's production pricing, but "cheap" is not
# "free": a runaway staging loop now costs real money. The per-family monthly
# story quota (ADR-015 G7) is the backstop; keep it low on staging.
# #VERIFY: confirm CYO_ADVENTURE_OPENROUTER_MODEL below is actually the pinned
# cheap id and not inherited from the production default before enabling any
# automated staging generation run.
#
# Staging now REQUIRES an OPENROUTER_API_KEY; it did not before. Use a
# staging-scoped key with its own spend limit, never the production key.
# -----------------------------------------------------------------------------
CYO_ADVENTURE_GENERATION_PROVIDER=openrouter
CYO_ADVENTURE_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# The cascade's second leg is never model-overridden, so pin the fallback too or
# a failover silently lands on the expensive production default.
CYO_ADVENTURE_OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_KEY=REPLACE_ME

# -----------------------------------------------------------------------------
# Cover generation (nano banana) + Cloudflare R2 storage
# -----------------------------------------------------------------------------
# Same five R2 vars as .env.example; see that file for setup detail. NOTE:
# unlike story generation above, cover generation places billed Gemini image
# calls; leave GEMINI_API_KEY unset to disable covers on staging entirely.
# Staging shares the production bucket ("cyo") and its public custom domain
# by owner decision, so R2_BUCKET below is a real value, not a placeholder.
# The covers WORKER process needs these same vars in its own environment.
# GEMINI_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=cyo
# R2_PUBLIC_BASE_URL=https://cyo-bucket.williamshome.family

# -----------------------------------------------------------------------------
# Seed script inputs (scripts/seed_staging.py)
# -----------------------------------------------------------------------------
# Test account identities. Passwords are set at seed time via
# SEED_GUARDIAN_PASSWORD / SEED_ADMIN_PASSWORD (exported in the shell, never
# stored in this file) so a leaked .env.staging cannot grant login access.
SEED_GUARDIAN_EMAIL=cyo-test-guardian@example.com
SEED_ADMIN_EMAIL=cyo-test-admin@example.com
