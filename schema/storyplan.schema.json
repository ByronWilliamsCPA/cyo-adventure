{
  "$defs": {
    "AgeBand": {
      "description": "The reading age band a story targets.",
      "enum": [
        "3-5",
        "5-8",
        "8-11",
        "10-13",
        "13-16",
        "16+"
      ],
      "title": "AgeBand",
      "type": "string"
    },
    "BookRef": {
      "additionalProperties": false,
      "description": "Which book the plan was written for.",
      "properties": {
        "slug": {
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        },
        "storybook_id": {
          "minLength": 1,
          "title": "Storybook Id",
          "type": "string"
        },
        "storybook_version": {
          "minimum": 1,
          "title": "Storybook Version",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "storybook_id",
        "storybook_version",
        "title"
      ],
      "title": "BookRef",
      "type": "object"
    },
    "CastMember": {
      "additionalProperties": false,
      "description": "One character: role, want, voice notes and what they know (fact ids).",
      "properties": {
        "knows": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Knows",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "voice": {
          "minLength": 1,
          "title": "Voice",
          "type": "string"
        },
        "want": {
          "minLength": 1,
          "title": "Want",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "want",
        "voice"
      ],
      "title": "CastMember",
      "type": "object"
    },
    "CheckRecord": {
      "additionalProperties": false,
      "description": "Summary of the last structural check run recorded on a plan.",
      "properties": {
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "warnings": {
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "errors",
        "warnings"
      ],
      "title": "CheckRecord",
      "type": "object"
    },
    "ChoicePlan": {
      "additionalProperties": false,
      "description": "A choice's meaning: why, at what cost, what it presupposes and plants.",
      "properties": {
        "cost": {
          "minLength": 1,
          "title": "Cost",
          "type": "string"
        },
        "establishes": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Establishes",
          "type": "array"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "plants": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "items": {
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Plants"
        },
        "requires": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "intent",
        "cost"
      ],
      "title": "ChoicePlan",
      "type": "object"
    },
    "EndingKind": {
      "description": "What mechanically happened at an ending (closed set).",
      "enum": [
        "success",
        "setback",
        "death",
        "capture",
        "completion",
        "discovery"
      ],
      "title": "EndingKind",
      "type": "string"
    },
    "EndingPlan": {
      "additionalProperties": false,
      "description": "What an ending gives the reader: the reveal, the laugh, or the reason to retry.",
      "properties": {
        "gift": {
          "minLength": 1,
          "title": "Gift",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndingKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Valence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "gift"
      ],
      "title": "EndingPlan",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "One ledger fact: a sentence plus the facts it contradicts.",
      "properties": {
        "contradicts": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Contradicts",
          "type": "array"
        },
        "implicit_plant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implicit Plant"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Length": {
      "description": "The story-scale (length) tier: a total-word budget, world size.\n\nProduction stories place themselves on the ``(band, length, style)`` matrix\nfrom ADR-011; the node-count envelope is derived per cell. Young bands cap\nat ``MEDIUM``; epic scale is a series, not a fourth tier. A story that\ndeclares no length is not scale-classified and keeps the band-level budget.",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "title": "Length",
      "type": "string"
    },
    "NarrativeStyle": {
      "description": "Prose vs gamebook chunking of one word budget (ADR-011).\n\nMeaningful only for ``13-16`` and ``16+``; lower bands are implicitly\n``PROSE``. Gamebook packs the same total words into more, shorter nodes.",
      "enum": [
        "prose",
        "gamebook"
      ],
      "title": "NarrativeStyle",
      "type": "string"
    },
    "NodePlan": {
      "additionalProperties": false,
      "description": "A node's obligations: what happens, what it presupposes and adds.",
      "properties": {
        "establishes": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Establishes",
          "type": "array"
        },
        "event": {
          "minLength": 1,
          "title": "Event",
          "type": "string"
        },
        "function": {
          "minLength": 1,
          "title": "Function",
          "type": "string"
        },
        "requires": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "function",
        "event"
      ],
      "title": "NodePlan",
      "type": "object"
    },
    "PayoffSite": {
      "additionalProperties": false,
      "description": "Where a thread returns: the shared node, the choice that shows it, what it shows.",
      "properties": {
        "choice": {
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "title": "Node",
          "type": "string"
        },
        "shows": {
          "minLength": 1,
          "title": "Shows",
          "type": "string"
        }
      },
      "required": [
        "node",
        "choice",
        "shows"
      ],
      "title": "PayoffSite",
      "type": "object"
    },
    "Pitch": {
      "additionalProperties": false,
      "description": "The five-field pitch the owner reads for a catalog book.",
      "properties": {
        "ending_kind": {
          "minLength": 1,
          "title": "Ending Kind",
          "type": "string"
        },
        "hero": {
          "minLength": 1,
          "title": "Hero",
          "type": "string"
        },
        "obstacle": {
          "minLength": 1,
          "title": "Obstacle",
          "type": "string"
        },
        "stake": {
          "minLength": 1,
          "title": "Stake",
          "type": "string"
        },
        "want": {
          "minLength": 1,
          "title": "Want",
          "type": "string"
        }
      },
      "required": [
        "hero",
        "want",
        "obstacle",
        "stake",
        "ending_kind"
      ],
      "title": "Pitch",
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "description": "The request the book answers. ``text`` is untrusted when present.",
      "properties": {
        "band": {
          "$ref": "#/$defs/AgeBand"
        },
        "length": {
          "anyOf": [
            {
              "$ref": "#/$defs/Length"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "tone": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        }
      },
      "required": [
        "band"
      ],
      "title": "PlanRequest",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Who produced the plan, what it is bound to, and who approved it.",
      "properties": {
        "approver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approver"
        },
        "authored": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authored"
        },
        "authoring_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authoring Minutes"
        },
        "book_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Book File"
        },
        "book_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Book Sha256"
        },
        "checks": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ShapeRef": {
      "additionalProperties": false,
      "description": "The shape a plan was built for, by id and graph hash.",
      "properties": {
        "hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hash"
      ],
      "title": "ShapeRef",
      "type": "object"
    },
    "Thread": {
      "additionalProperties": false,
      "description": "A plant and its payoffs, bound to one Storybook variable.",
      "properties": {
        "payoff_sites": {
          "items": {
            "$ref": "#/$defs/PayoffSite"
          },
          "minItems": 1,
          "title": "Payoff Sites",
          "type": "array"
        },
        "plant": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Plant",
          "type": "string"
        },
        "planting_choices": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Planting Choices",
          "type": "array"
        },
        "variable": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "variable",
        "plant",
        "planting_choices",
        "payoff_sites"
      ],
      "title": "Thread",
      "type": "object"
    },
    "Truth": {
      "additionalProperties": false,
      "description": "The book's one canonical answer and the facts that make it up.",
      "properties": {
        "facts": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "question": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "facts"
      ],
      "title": "Truth",
      "type": "object"
    },
    "Valence": {
      "description": "How an ending feels, independent of what mechanically happened.",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "title": "Valence",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A complete Story Plan (ADR-033 Decision 1). See the module docstring.",
  "properties": {
    "book": {
      "anyOf": [
        {
          "$ref": "#/$defs/BookRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cast": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/CastMember"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Cast",
      "type": "object"
    },
    "choices": {
      "additionalProperties": {
        "$ref": "#/$defs/ChoicePlan"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Choices",
      "type": "object"
    },
    "endings": {
      "additionalProperties": {
        "$ref": "#/$defs/EndingPlan"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Endings",
      "type": "object"
    },
    "facts": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Fact"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Facts",
      "type": "object"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/NodePlan"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "title": "Nodes",
      "type": "object"
    },
    "pitch": {
      "$ref": "#/$defs/Pitch"
    },
    "plan_version": {
      "default": "0.1",
      "title": "Plan Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "request": {
      "$ref": "#/$defs/PlanRequest"
    },
    "threads": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Thread"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Threads",
      "type": "object"
    },
    "truth": {
      "$ref": "#/$defs/Truth"
    }
  },
  "required": [
    "request",
    "pitch",
    "cast",
    "truth",
    "facts",
    "nodes",
    "provenance"
  ],
  "title": "StoryPlan",
  "type": "object"
}
