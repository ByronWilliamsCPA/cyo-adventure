{
 "narrative_version": 1,
 "skeleton_slug": "the-clocktower-cipher",
 "age_band": "10-13",
 "facts": {
  "tower_sealed": "the clocktower stands sealed, and the seal reads like a test rather than an accident",
  "challenge_posted": "a coded challenge is pinned to the door, clearly meant to be attempted by whoever finds it",
  "friends_committed_together": "the friends face the challenge as a group; no one takes it alone",
  "challenge_accepted": "the friends have chosen to take the maker's challenge seriously",
  "patience_proven": "working the note's cipher line by line proves patience is the price of its first answer",
  "route_named_by_note": "the proven line names a specific way in and what waits there",
  "self_reliance_shown": "two overlooked ways in, a low gap and a high window, have been found by the friends' own persistence",
  "keeper_tested_them": "the keeper has watched the friends and reads as gruff but fair, testing more than warning",
  "keeper_offer_earned": "the keeper, satisfied, offers both a way in and what he knows of the maker",
  "maker_motive_understood": "the maker built the tower's tests decades ago out of care, to find the right kind of finder",
  "past_the_seal": "the friends stand past the tower's seal, however they earned it",
  "trial_rooms_known": "four testing rooms are known: a climb, a study, a crossing, and a descent",
  "logic_earned": "the friends carry a working grasp of the cipher's logic, earned by clearing some room's test",
  "archive_beckons": "the study's archive poses its own quiet test: stay for it, or press on",
  "crossing_dares_them": "the crossing room is the tower's most direct test of nerve",
  "reward_glimpsed": "something the maker set aside for whoever passes waits at the crossing's far end",
  "at_the_dial": "the friends stand at the great dial, the tower's final examiner",
  "dial_test_live": "the dial's own markings state its test plainly: what to set, and that guessing has a cost",
  "test_passed": "the friends passed the dial's test on the maker's own terms",
  "test_forced": "forcing the dial fails its test and jams the mechanism instead",
  "second_test_found": "a second, smaller test is found behind the dial",
  "sanctum_entered": "the friends stand inside what the trial protected",
  "sanctum_seen": "what the trial protected is seen: the maker's letter and modest things meant for everyone",
  "composure_kept": "the friends leave with their composure intact; the outcome is a result, never a shaming",
  "trial_reopens": "the tower's trial can be attempted again; nothing about it is used up",
  "record_set_straight": "whatever was disturbed is put back and owned honestly to the keeper",
  "workshop_found": "the maker's living workshop is found past the second test",
  "stewardship_earned": "the friends earn ongoing responsibility for what they found",
  "passing_made_public": "the friends' passing of the trial is shared with the settlement",
  "passing_kept_private": "the friends' passing of the trial stays a private matter among them",
  "trust_bond_formed": "the shared trial forges a lasting trust between the friends",
  "keeper_intervenes": "the keeper turns up in the moment of temptation, mid-test whether the friends know it or not"
 },
