  component "EventType\nevents/models.py\n29-value StrEnum:\nREQUEST_CREATED/APPROVED/DECLINED,\nPLAN_ASSIGNED, GENERATION_STARTED/\nFINISHED, MODERATION_COMPLETED,\nREPAIR_APPLIED, SENT_BACK, RELEASED,\nSTORYBOOK_ARCHIVED, THRESHOLD_CHANGED,\nNOISE_FLOOR_CHANGED, BOOK_ASSIGNED,\nBOOK_UNASSIGNED, RATED,\nUSER_MANAGED, FAMILY_MANAGED,\nFAMILY_CONNECTION_CHANGED,\nKID_FLAGGED, FLAG_RESOLVED, NODE_EDITED,\nPROFILE_VIEWED, CELL_SATURATED,\nPERSONALIZATION_TOGGLED [ADR-023 P3],\nRING2_CONSENT_GRANTED/REVOKED [ADR-023 P4],\nSTORYBOOK_REMODERATED,\nNOTIFICATION_DIGEST_READY" as event_type #FFECB3

