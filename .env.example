# =============================================================================
# CYO Adventure - Backend & Docker Compose environment
# =============================================================================
# Copy to `.env` and set only what you need. This file configures the FastAPI
# backend (Pydantic Settings in src/cyo_adventure/core/config.py) and the
# docker-compose stack.
#
# Scope:
#   - The React app has its OWN example at frontend/.env.example
#     (VITE_* and Supabase browser keys). Do not duplicate those here.
#   - CI-only tokens (Codecov, SonarCloud, Infisical machine identity, the
#     Anthropic review-workflow key) live in GitHub Secrets and are documented
#     in README.md, not in this file.
#
# Naming convention: backend settings use the CYO_ADVENTURE_ prefix, EXCEPT the
# handful read from unprefixed names via validation_alias (ENVIRONMENT,
# OPENROUTER_API_KEY, ANTHROPIC_API_KEY, MODAL_*, OPENAI_API_KEY,
# PERSPECTIVE_API_KEY, OIDC_*, GEMINI_API_KEY, R2_*, KWS_*).
# Never commit real secrets; source them from a secret manager (Infisical).

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
# Deployment stage: local | dev | staging | production. Any non-local value
# activates the fail-fast startup guards in core/config.py (a real database URL
# and OIDC config both become mandatory).
ENVIRONMENT=local
LOG_LEVEL=INFO
JSON_LOGS=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL, async SQLAlchemy)
# -----------------------------------------------------------------------------
# Local dev defaults to peer/trust auth (no password), so this can stay unset.
# Set it if your local Postgres requires a password. REQUIRED in every non-local
# environment: the app refuses to start with the dev default outside "local".
# CYO_ADVENTURE_DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/cyo_adventure
#
# The worker processes' database credential (ADR-021). Unset falls back to
# CYO_ADVENTURE_DATABASE_URL, which is correct for local dev (one credential,
# and RLS never applies to the local owner role anyway). In staging and
# production it must name the cyo_worker role; leaving it unset there silently
# keeps the worker on the API's credential. See docs/operations/runbook.md
# section 11.
# CYO_ADVENTURE_WORKER_DATABASE_URL=postgresql+asyncpg://cyo_worker:<password>@localhost:5432/cyo_adventure
#
# docker-compose Postgres service knobs:
DB_PASSWORD=password
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis (RQ generation queue) - optional
# -----------------------------------------------------------------------------
# Only needed when running the background generation queue. Defaults to local.
# CYO_ADVENTURE_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Story generation providers
# -----------------------------------------------------------------------------
# Which LLM backend generates stories: mock | anthropic | openrouter | modal.
# "mock" (default) makes no live calls, so CI and local runs stay free/offline.
# CYO_ADVENTURE_GENERATION_PROVIDER=mock

# Direct Anthropic API (WS-C PR1). Required only when the generation provider
# (globally or per-job) is anthropic; a missing key surfaces as a
# ConfigurationError at call time, not startup.
# ANTHROPIC_API_KEY=

# OpenRouter (cloud). Required only when a provider is set to openrouter.
OPENROUTER_API_KEY=
# Optional model override (defaults are pinned in config.py per ADR-003):
# CYO_ADVENTURE_OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Modal (self-hosted generation leg; ADR-010). Since the Ollama retirement this
# is ALSO the third leg of the default openrouter cascade, replacing the local
# Ollama leg as the non-OpenRouter backstop: set MODAL_BASE_URL and MODAL_MODEL
# and the cascade becomes [OpenRouter primary, OpenRouter fallback, Modal].
# Leave them unset and the cascade degrades to its two OpenRouter legs, which
# share one vendor and one account, so an OpenRouter outage stops generation
# outright; build_provider logs generation.cascade_single_vendor at WARNING when
# that happens. Configure this in any deployment you care about the uptime of.
# Deploy one Modal Auto Endpoint first (see
# docs/guides/modal-endpoint-deployment.md), then set the vars below; setting
# CYO_ADVENTURE_GENERATION_PROVIDER=modal additionally selects it as the SOLE
# backend (no cascade), which is the offline/experimental mode.
# MODAL_PROXY_KEY/MODAL_PROXY_SECRET are a Modal-Key/Modal-Secret proxy-token
# pair (created via `modal workspace proxy-tokens create`), not a Bearer token;
# either set both or leave both unset, never just one. A half-set pair is now
# rejected at STARTUP (config.py::_require_modal_proxy_credentials_together),
# not at job time: with Modal on the default cascade it would otherwise fail
# every generation job rather than only an explicit Modal run.
# MODAL_BASE_URL=https://<workspace>--cyo-standard.modal.run/v1
# MODAL_MODEL=google/gemma-4-26b-a4b-it
# MODAL_PROXY_KEY=
# MODAL_PROXY_SECRET=

# -----------------------------------------------------------------------------
# Cover generation (nano banana) + Cloudflare R2 storage
# -----------------------------------------------------------------------------
# GEMINI_API_KEY authenticates the nano banana (Gemini image) cover-art model
# (covers/provider.py). Leaving it unset disables cover generation entirely;
# the endpoint (api/covers.py) returns a config error rather than enqueuing.
# GEMINI_API_KEY=
#
# Optimized WebP covers upload to Cloudflare R2 via the S3-compatible API
# (covers/storage.py). All four vars below must be set together, or cover
# generation is treated as unconfigured. R2_ACCOUNT_ID derives the endpoint
# (https://<account>.r2.cloudflarestorage.com); create the access key pair
# under R2 > Manage API Tokens (scope it to Object Read & Write on this
# bucket only). R2_PUBLIC_BASE_URL is only the naming prefix recorded in the
# cover_image_url audit column: upload_cover joins it to the object key and
# stores the result, and scripts/backfill_covers_r2.py classifies URLs by it.
# Do NOT bind a public custom domain or r2.dev access to the bucket to make
# that URL resolve. Covers are served to clients exclusively as short-lived
# presigned GET URLs minted per request
# (covers/storage.py::generate_presigned_cover_url), and the bucket must stay
# private; see the #CRITICAL: security invariant at the top of
# src/cyo_adventure/covers/storage.py. A public bucket defeats the whole
# presigned-URL design and, because cover object keys are deterministic
# ({storybook_id}/{version}.webp), it also lets anyone who can guess a key
# fetch a cover that has not passed the H2 human-approval gate.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=covers
# R2_PUBLIC_BASE_URL=https://images.example.com

# -----------------------------------------------------------------------------
# Content moderation / safety review (Phase 3)
# -----------------------------------------------------------------------------
# Independent review backend: mock | openrouter | modal. "mock" (default) runs
# no real review, and "modal" is still deferred to slice 2b, so "openrouter" is
# the only live option ("ollama" was removed with the Ollama retirement).
# The reviewing model must come from a different
# provider than the generation model to preserve the independence invariant.
# When set to a live provider, at least one Stage-0 classifier key below MUST be
# set or the app refuses to start.
CYO_ADVENTURE_REVIEW_PROVIDER=mock
# Nodes per Stage-1 safety review call (1-50; default 8). The default was
# ratified by the Gate 3 recall comparison (2026-08-01, two identical runs,
# artifact docs/planning/safety/batch-sweep-results-2026-08-01.json): zero
# recall regression vs single-node calls at sizes 4 and 8, zero parse
# failures. Set to 1 to restore the pre-chunking one-node-per-call behavior;
# re-run the adversarial-harness batch sweep before raising it again after
# any reviewer-model or batch-prompt change.
# See src/cyo_adventure/core/config.py::review_batch_size.
# CYO_ADVENTURE_REVIEW_BATCH_SIZE=8
# Stage-0 deterministic classifiers (both optional; each unset one is skipped):
# OpenAI Moderation API (omni-moderation-latest; free; sexual/minors category):
OPENAI_API_KEY=
# Google Perspective API (Comment Analyzer; free with quota):
PERSPECTIVE_API_KEY=

# -----------------------------------------------------------------------------
# Authentication - OIDC / Supabase Auth (ADR-009; Phase 6)
# -----------------------------------------------------------------------------
# Guardian bearer tokens are verified as real OIDC JWTs in every environment
# except "local". Outside "local", BOTH vars below are REQUIRED at startup;
# there would otherwise be no way to verify a bearer token. Provider-agnostic by
# design: the values point at Supabase's GoTrue issuer today, but the backend
# verifies signatures via jwt.PyJWKClient and imports no Supabase SDK. Find both
# under Supabase dashboard > Project Settings > API. The browser-side
# VITE_SUPABASE_* keys belong in frontend/.env.example, not here.
# OIDC_ISSUER=https://your-project-ref.supabase.co/auth/v1
# OIDC_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Expected `aud` claim. Supabase issues "authenticated" for any signed-in user;
# only change this if the project has a custom audience configured.
OIDC_AUDIENCE=authenticated
# JWT signature-algorithm allowlist as a JSON list (ADR-013: hybrid PQC
# readiness). Defaults to what Supabase issues today; a future post-quantum
# JOSE algorithm (e.g. ML-DSA) becomes an env change, not a code change.
# Startup validation rejects an empty list, "none", and the symmetric HS*
# family, so this knob cannot reopen the classic JWT forgeries.
# OIDC_ALLOWED_ALGS=["RS256","ES256"]

# -----------------------------------------------------------------------------
# Child sessions - kid-surface tokens (G1 / P6-04)
# -----------------------------------------------------------------------------
# The kid surface uses a guardian-minted, backend-signed HS256 JWT (NOT a
# Supabase account) scoped to one child profile. CHILD_SESSION_SECRET signs and
# verifies those tokens and must never reach the browser. Outside "local" it is
# REQUIRED at startup. Generate a fresh high-entropy value (>=32 bytes) per
# environment, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# CHILD_SESSION_SECRET=
# Token lifetime in seconds. Default 43200 (12h): long enough for one offline
# reading session, since a child session cannot be refreshed.
# CHILD_SESSION_TTL_SECONDS=43200

# -----------------------------------------------------------------------------
# Device grants - durable device authorization (ADR-014 phase 1)
# -----------------------------------------------------------------------------
# A guardian mints a durable, family-scoped, backend-signed HS256 JWT once per
# shared device (NOT a login). DEVICE_GRANT_SECRET signs and verifies those
# tokens, must never reach the browser, and must be DISTINCT from
# CHILD_SESSION_SECRET. Outside "local" it is REQUIRED at startup. Generate a
# fresh high-entropy value (>=32 bytes) per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# DEVICE_GRANT_SECRET=
# Token lifetime in seconds. Default 7776000 (90 days): long enough that a
# shared family device stays authorized between guardian visits, short enough
# to bound a lost/stolen device's exposure (revocation cannot be enforced
# offline).
# DEVICE_GRANT_TTL_SECONDS=7776000

# -----------------------------------------------------------------------------
# Parent Verification Service - Kids Web Services (KWS, Epic); ADR-018
# -----------------------------------------------------------------------------
# Unset credentials mean the integration is UNCONFIGURED and no KWS call is ever
# made; there is no separate enable flag, matching the GEMINI_API_KEY / R2_*
# pattern elsewhere in this file.
#
# SCOPE, and read this before treating any of it as COPPA compliance. Epic's own
# documentation states the Parent Verification (PV) Service "has not been
# designed to obtain consent from verified parents or guardians or to address
# direct notice requirements when required by applicable law (such as COPPA)". It
# establishes that an adult is an adult. The consent leg (16 CFR 312.5) and the
# direct-notice leg (312.4) remain ours to build and evidence. Epic sells a
# separate Consent Management Service that combines verification and consent in
# one flow; it is not self-serve and is obtained through a Technical Account
# Manager. So these variables buy an adult-verification signal, not a finished
# VPC mechanism, and nothing here should be cited as satisfying either rule.
#
# Wired against the KWS *Test* environment first, deliberately, to answer
# empirically what the documentation leaves open: whether the parent-verified
# webhook fires at all on the pre-verified (AgeGraph) path, and what the card
# methods actually charge. Record every finding as "observed in KWS Test on
# <date>", never as a claim about production: a sandbox may stub payment.
#
# Which environment produced a consent record. Stored on every verification
# record and never inferred from KWS_API_ORIGIN, so a Test verification can never
# be read back as a real one. Defaults to "test" because the failure modes are
# asymmetric: mislabelling a real consent as a test is recoverable, and treating
# a sandbox verification as genuine parental consent is not.
# KWS_ENVIRONMENT=test
#
# Which of the environments this is. The Control Panel allows up to 5 (exactly
# one Production, at least one Test), each with its own label and its own
# credentials, so the type above does not identify the source on its own.
# KWS_ENVIRONMENT_LABEL=
#
# Tenant and product identifiers. The organization id is shown unmasked on the
# Integration Information tab and is CONSTANT across environments; the client id
# and API key are issued per environment. That asymmetry is what makes
# KWS_ENVIRONMENT a real partition rather than a label we assert: reaching
# Production requires actively pasting a different credential.
#
# The product id is not on that tab, but every webhook body carries both `orgId`
# and `productId`, so it exists as a distinct identifier and both are recorded on
# the verification record. Leave the product id unset until a webhook reveals it,
# then pin it so an inbound event for some other product is rejected rather than
# attributed to us.
# KWS_ORGANIZATION_ID=
# KWS_PRODUCT_ID=
#
# Two DISTINCT hosts, confirmed from the API documentation rather than assumed.
# The API origin is the "Service API host URL" on the Integration Information
# tab. Token minting is on a Keycloak realm at a different host entirely:
#   POST https://auth.kidswebservices.com/auth/realms/kws/protocol/openid-connect/token
# so a single base URL cannot express both. The auth host shown below is the
# documented one; confirm it against your environment rather than assuming the
# Test environment shares it.
# KWS_API_ORIGIN=
# KWS_AUTH_ORIGIN=https://auth.kidswebservices.com
#
# OAuth2 client-credentials pair, sent as HTTP Basic against the token endpoint
# (client id is the username, API key the password) with
# grant_type=client_credentials&scope=verification. The Control Panel calls the
# secret half an API key, so it is named that here rather than "client secret";
# they are the same value. Set BOTH or neither: one without the other is a
# misconfiguration the app should refuse rather than half-enable.
#
# The token response carries `expires_in` (documented example: 3600) but the
# lifetime varies with usage, so the client must ALSO re-authenticate reactively
# on a 401 rather than trusting the advertised TTL alone. The API key itself is
# issued with a multi-year expiry and a "Rotate secret" button, so rotation is a
# calendar item rather than something an expiry will prompt, and it takes a
# restart to pick up.
# KWS_CLIENT_ID=
# KWS_API_KEY=
#
# Sent as the User-Agent on every KWS API call. This is REQUIRED, not cosmetic:
# a request with a missing or empty user-agent is rejected with 403 "Request
# blocked". Any non-empty string identifying the client will do.
#
# This and KWS_WEBHOOK_MAX_SKEW_SECONDS below are the two KWS variables that are
# NOT optional-with-a-None-default, so an empty value would ordinarily be a
# validation error at startup rather than an unset variable. Both now coerce an
# empty string back to the default, which makes the standard compose idiom
# `${KWS_USER_AGENT:-}` safe: without that, the same line that is correct for
# every credential below would stop the container from booting.
# KWS_USER_AGENT=
#
# Webhook authenticity, for the `parent-verified` event. KWS signs with the
# Stripe-style scheme: an `x-kws-signature` header of the form
# `t=<epoch-seconds>,v1=<hex>`, where the hex is HMAC-SHA256 over the literal
# string `{t}.{raw request body}` keyed by this secret. The documentation is
# explicit that the RAW body must be used and warns against parsing and
# re-stringifying the JSON, since library differences produce mismatches. The
# webhook URL is deliberately excluded from the signed material.
#
# The header may carry MORE THAN ONE `v1=` component (the documented form is
# `t=<timestamp>,v1=<signature>[,v1=<signature>]`), which is how a secret
# rotation stays non-breaking. A verifier must accept a match against ANY of
# them; taking only the first silently fails mid-rotation.
#
# Unset means inbound webhooks are REJECTED rather than trusted: an unverifiable
# consent event is worse than a missed one, because it would become our evidence
# of a consent that may never have happened.
# KWS_WEBHOOK_SECRET=
#
# The redirect return leg uses a DIFFERENT secret AND a different construction:
# HMAC-SHA256 over `{status}:{externalPayload}` with NO timestamp, arriving as a
# `signature` query parameter alongside the URL-encoded JSON `status`. A verifier
# written for the webhook is therefore wrong here; they do not share code.
# Required only if we configure a Redirect URL; without one, KWS shows its own
# success screen and the webhook is the sole channel.
# KWS_VERIFICATION_SECRET=
#
# Replay window for the `t=` component, in seconds. KWS puts the timestamp INSIDE
# the signed string precisely so this can be enforced; a verifier that checks
# only the MAC leaves a captured webhook replayable forever.
# KWS_WEBHOOK_MAX_SKEW_SECONDS=300
#
# Which verification methods are switched on for this environment, mirrored from
# the Control Panel's "Verification methods" tab as a comma-separated list. This
# is EVIDENCE, not a preference, and REQUIRED once the credentials above are set:
# the parent-verified webhook reports no method, so the enabled set at the moment
# of verification is the only bound on which method could have run, and reading
# it live from the Control Panel would erase that bound retroactively for every
# record ever written the instant someone toggles a row. It also has retroactive
# reach through AgeGraph, which pre-verifies a parent only when they verified
# "using a verification method enabled for the current product": switching a
# method on silently converts parents verified that way elsewhere into
# pre-verified for us, with no new verification event on our side.
#
# Known names (availability is regional and enforced by KWS, not by us):
#   social_security_number     US and territories only
#   id_scan, face_scan         worldwide EXCEPT the US, its territories, Korea
#   curp_number                Mexico
#   cpf_number                 Brazil
#   cell_phone_certification   Korea
#   ipin_authentication        Korea
#   credit_card                worldwide except a sanctions list
#   debit_card                 as credit_card, and NOT the United Kingdom
#
# For a US family that leaves exactly three options, so cards are effectively
# the choice. Note the COPPA condition on them: 16 CFR 312.5(b)(2) accepts a
# card only where the payment system "provides notification of each discrete
# transaction to the primary account holder", which a zero-dollar authorization
# hold does not do. Epic's flow docs mention "authorization, capture, and
# refunds, depending on the country or region's specific requirements", which
# suggests they capture where required; confirm it rather than assuming it.
# KWS_ENABLED_METHODS=credit_card,debit_card
#
# Whether this tier RUNS verification, which is a separate question from
# whether it holds credentials. Off means the child-profile gates do not
# require a verification, and it also means POST /v1/consent/kws/start refuses:
# that endpoint discloses an adult's email address to Epic, so credential
# presence must not be what opens it. Turning this on is a deliberate per-tier
# act, taken once the start endpoint and its screens are deployed there.
# KWS_VERIFICATION_REQUIRED=false
#
# The single, separately auditable escape from the line above, and ONLY for the
# start endpoint. It exists so staging can exercise that endpoint and the
# screens in front of it while the gate is still off. It is REFUSED at startup
# whenever KWS_ENVIRONMENT=production: setting it there would disclose real
# parents' addresses to Epic for a flow nothing gates on, so the process stops
# rather than quietly re-opening the endpoint. Note it is not needed by the
# Gate 1 procedure in docs/operations/kws-test-runbook.md, which calls the
# service directly and never reaches the endpoint.
# KWS_ALLOW_START_WHILE_NOT_REQUIRED=false
#
# Three constraints that shape code rather than config, recorded here because
# nothing else in the repo states them yet:
#
#  1. `externalPayload` is our own opaque round-trip correlation blob, a JSON or
#     UTF-8 string capped at 250 characters, echoed back in both the webhook and
#     the redirect. Keep it to opaque identifiers and resolve everything else
#     from our own tables; no child or parent identifier belongs in it.
#  2. Requests are rate limited to TEN PER HOUR per unique parent email address,
#     in test and production alike. That bounds retry behaviour and it bounds
#     how fast the Test-environment experiments can iterate on one address.
#  3. The webhook `status` object carries `verified` and `transactionId` only. It
#     does NOT name which verification method the parent completed, so the
#     inability to evidence the method is a property of the vendor's contract,
#     not an omission in our schema. The webhook body does deliver `parentEmail`
#     in cleartext, which is a deliberate retention decision rather than an
#     accident of the integration.

# -----------------------------------------------------------------------------
# Docker Compose stack knobs (docker-compose.yml / docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# Image tag. Production REQUIRES an explicit immutable release tag or digest.
VERSION=latest
# Host ports:
APP_PORT=8000
FRONTEND_PORT=3000
# Redis service knobs (compose defaults shown):
# REDIS_PORT=6379
# REDIS_PASSWORD=redispassword
# Frontend API wiring: two DIFFERENT variables, deliberately named apart, and
# BOTH left commented out on purpose. Compose auto-loads this file's copy (the
# root .env) for interpolation, and `${VAR:-default}` falls back only when the
# variable is unset or empty, so an uncommented line here silently overrides the
# compose default for every developer who copied this template.
#
#   VITE_API_URL          Production BUILD ARG only
#                         (docker-compose.prod.yml:160). Baked into the shipped
#                         bundle and read by frontend/src/hooks/apiBaseUrl.ts in
#                         PROD builds. The compose default `/api` is correct for
#                         the same-origin nginx deployment, so leave it unset
#                         unless the backend really lives on another origin.
#   DEV_API_PROXY_TARGET  Dev-only in-container proxy target for
#                         docker-compose.yml's Vite dev server. Defaults to
#                         http://host.docker.internal:${APP_PORT}. Never set it
#                         to a localhost URL: inside the frontend container
#                         `localhost` is that container's own loopback, so every
#                         /api call 502s and the guardian is dropped on
#                         "We can't reach CYO Adventure" after signing in.
#
# Setting VITE_API_URL to a dev value is the trap the split exists to prevent:
# it would bake `host.docker.internal` into a production build.
# VITE_API_URL=
# DEV_API_PROXY_TARGET=http://host.docker.internal:8000
# Replica counts (production):
REPLICAS=2
FRONTEND_REPLICAS=1

# -----------------------------------------------------------------------------
# Observability - Sentry (optional; wired via core/observability.py::init_sentry,
# called from app.py::create_app())
# -----------------------------------------------------------------------------
# Unset (default) is a documented no-op: init_sentry() never calls
# sentry_sdk.init(), so local dev and CI need nothing here. Set it to enable
# error tracking; send_default_pii is hardcoded False in code (never a setting)
# so Sentry never receives child/guardian PII from this app.
# SENTRY_DSN=
# Fraction of transactions sampled for Sentry performance tracing (0.0-1.0).
# Low by default: this is error tracking first, not full APM.
# CYO_ADVENTURE_SENTRY_TRACES_SAMPLE_RATE=0.1
